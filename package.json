{
  "name": "fullstack-spa-app",
  "version": "1.0.0",
  "description": "Full-stack SPA with React 18 frontend and Node.js/Express backend",
  "main": "backend/server.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=frontend\" \"npm run dev --workspace=backend\"",
    "frontend": "npm run dev --workspace=frontend",
    "backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=frontend",
    "preview": "npm run preview --workspace=frontend"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
